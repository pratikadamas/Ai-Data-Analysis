# Rename this file to .env and fill in real values. Never commit .env.

# --- Database Settings ---
# MongoDB connection string (local or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=ai_data_analyst

# --- AI Settings ---
# Groq API key used for NL -> SQL generation and explanations
# Get yours free at: https://console.groq.com/keys
GROQ_API_KEY=

# --- Email Settings ---
# Required for sending OTP during registration
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_STARTTLS=True
MAIL_SSL_TLS=False

# --- App Settings ---
APP_ENV=development
MAX_UPLOAD_MB=200
UPLOAD_DIR=./uploads
CORS_ORIGINS=http://localhost:5173
