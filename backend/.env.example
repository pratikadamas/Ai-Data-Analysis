# Rename this file to .env and fill in real values. Never commit .env.

# --- Database Settings ---
# MongoDB connection string (local or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=ai_data_analyst

# --- AI Settings ---
# Groq API key used for NL -> SQL generation and explanations
# Get yours free at: https://console.groq.com/keys
GROQ_API_KEY=

# --- Email Settings ---
# Option 1 (RECOMMENDED for Render/Cloud/Production): Modern HTTP API (Port 443 - NEVER blocked by cloud firewalls)
# Get a free key at https://resend.com (3,000 emails/month free)
RESEND_API_KEY=
# Or get a free key at https://brevo.com (300 emails/day free)
BREVO_API_KEY=

# Option 2: Standard SMTP (Gmail App Password - note: Render/AWS block outbound ports 587/465)
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=your_email@gmail.com
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_STARTTLS=True
MAIL_SSL_TLS=False

# --- App Settings ---
APP_ENV=development
MAX_UPLOAD_MB=200
UPLOAD_DIR=./uploads
CORS_ORIGINS=http://localhost:5173
